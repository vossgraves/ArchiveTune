    PlayerView with SurfaceView surface_type. Used on API 34+
    (UPSIDE_DOWN_CAKE) where ExoPlayer's setOutputSurface path can swap
    surfaces in place without re-creating the video codec — making
    fullscreen toggle / orientation change a zero-cost surface swap.

    Ported from Flow's app/src/main/res/layout/video_player_view_surface.xml.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_artwork_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    app:use_controller="false"
    app:surface_type="surface_view"
    app:keep_content_on_player_reset="false" />
