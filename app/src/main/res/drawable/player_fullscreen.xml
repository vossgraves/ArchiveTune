<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Fullscreen enter: four solid triangle arrowheads, one in each corner,
         each pointing OUTWARD toward its corner. Clean, modern, and clearly
         different from the classic L-bracket design. -->
    <!-- Top-left arrowhead (tip at corner, points NW) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3,3 L10,3 L3,10 Z"/>
    <!-- Top-right arrowhead (tip at corner, points NE) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M21,3 L21,10 L14,3 Z"/>
    <!-- Bottom-left arrowhead (tip at corner, points SW) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3,21 L3,14 L10,21 Z"/>
    <!-- Bottom-right arrowhead (tip at corner, points SE) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M21,21 L14,21 L21,14 Z"/>
</vector>
