    <!-- Quality / settings sliders: three horizontal lines, each with a
         circular handle at a different horizontal position. This is the
         modern convention used by YouTube, Netflix, and most modern video
         players for the quality / settings menu. Cleaner and more
         recognizable than the previous "H in a square" badge. -->
    <!-- Top slider line (handle on the right) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4,6.5 L20,6.5 L20,7.5 L4,7.5 Z"/>
    <!-- Top handle (circle at x=16, y=7, r=2.5) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M13.5,7 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z"/>

    <!-- Middle slider line (handle in the center) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4,11.5 L20,11.5 L20,12.5 L4,12.5 Z"/>
    <!-- Middle handle (circle at x=12, y=12, r=2.5) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M9.5,12 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z"/>

    <!-- Bottom slider line (handle on the left) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4,16.5 L20,16.5 L20,17.5 L4,17.5 Z"/>
    <!-- Bottom handle (circle at x=8, y=17, r=2.5) -->
