<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Fullscreen exit: four solid triangle arrowheads, one in each corner,
         each pointing INWARD toward the center. The mirror of the fullscreen
         enter icon. -->
    <!-- Top-left arrowhead (tip at center end, points SE) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3,3 L10,3 L10,10 Z"/>
    <!-- Top-right arrowhead (tip at center end, points SW) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M21,3 L21,10 L14,10 Z"/>
    <!-- Bottom-left arrowhead (tip at center end, points NE) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3,21 L3,14 L10,14 Z"/>
    <!-- Bottom-right arrowhead (tip at center end, points NW) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M21,21 L14,21 L14,14 Z"/>
</vector>
